# ---- 数据源 ----
# 数据源: akshare(免费默认) / tushare(需token) / csv(本地)
DATA_PROVIDER=akshare
# Tushare Token（https://tushare.pro 注册获取；daily 日线可用，daily_basic 需 2000 积分）
TUSHARE_TOKEN=

# iFinD 同花顺账号（可选，v2 数据抓取用）
IFIND_ACCOUNT=
IFIND_PASSWORD=

# ---- 回测默认参数 ----
INITIAL_CAPITAL=20000
FEE_RATE=0.00025
COMMISSION_MIN=5.0
STAMP_TAX=0.0005
TRANSFER_FEE=0.00001
SLIPPAGE=0.02
